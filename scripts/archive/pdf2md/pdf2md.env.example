# pdf2md 配置文件（复制本文件为 pdf2md.env 后填入真实值）
#
# 本工具只读本目录的 pdf2md.env 或 .env，不向上查找仓库根。
# 也可用 --env <path> 或环境变量 PDF2MD_ENV 指向别处。
#
# 两个端点都必须是 OpenAI 兼容的 /v1/chat/completions，
# 且模型要支持 image_url 类型的 content（视觉输入）——
# 整条链路的公式与正文识别都靠看渲染图，不支持视觉就完全跑不动。

# local：主转写模型，负责全部块。要求：支持视觉、能关思考、速度快
LLM_LOCAL_URL=http://192.168.0.102:8000/v1
LLM_LOCAL_API_KEY=your-key
LLM_LOCAL=qwen-3.6-crack

# smart：复核模型，仅在校验失败时调用。要求：视觉能力强于 local
# 限流（429）时会自动按 SMART_FALLBACKS 顺序轮换
LLM_SMART_URL=http://192.168.0.102:4006/v1
LLM_SMART_API_KEY=your-key
LLM_SMART=deepseek-v4.1-flash

# 复核模型的备选顺序（逗号分隔）。主模型限流时依次尝试。
SMART_FALLBACKS=mimo-v2.6-flash,space-bunny,kimi-k3